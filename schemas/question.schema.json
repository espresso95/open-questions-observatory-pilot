{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"OQO pilot question v1.0",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","id","title","scope","disciplines","source_evidence","statuses","resolved","literature_search","assessment","run_ids","created_at"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "id":{"type":"string","pattern":"^Q-[A-Z0-9-]+$"},
    "title":{"type":"string","minLength":10},
    "scope":{"type":"object","required":["system","claim","parent_problem","relationship","data_window"],"additionalProperties":{"type":"string"}},
    "disciplines":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "source_evidence":{"type":"array","minItems":1,"items":{"type":"object","required":["source_id","source_hash","text_hash","quote","start","end","location"],"properties":{"source_id":{"type":"string"},"source_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"text_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"quote":{"type":"string","minLength":1},"start":{"type":"integer","minimum":0},"end":{"type":"integer","minimum":1},"location":{"type":"string"}}}},
    "statuses":{"type":"object","additionalProperties":false,"required":["literature","feasibility","research","validation","publication"],"properties":{
      "literature":{"enum":["unchecked","no_answer_found","partial_answer","addressed_in_literature","contested"]},
      "feasibility":{"enum":["unassessed","needs_information","data_blocked","lab_dependent","compute_blocked","safety_blocked","pilot_ready"]},
      "research":{"enum":["not_started","planned","running","completed","failed","inconclusive","stopped_budget"]},
      "validation":{"enum":["unreviewed","automated_checks_passed","computationally_reproduced","human_reviewed","externally_reviewed"]},
      "publication":{"enum":["private_draft","approved_for_disclosure","public_candidate","published","corrected","withdrawn"]}
    }},
    "resolved":{"const":false},
    "literature_search":{"type":"object","required":["queries","assessed_sources","limitations","decision"],"properties":{"queries":{"type":"array","minItems":1},"limitations":{"type":"array","minItems":1}}},
    "assessment":{"type":"object","required":["ratings","score","blockers","dispatch_eligible","evidence"],"properties":{"score":{"type":"number","minimum":0,"maximum":100},"blockers":{"type":"array"},"dispatch_eligible":{"type":"boolean"}}},
    "run_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^R-[a-f0-9]{12}$"}},
    "created_at":{"type":"string","format":"date-time"}
  }
}
