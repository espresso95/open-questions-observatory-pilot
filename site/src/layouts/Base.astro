---
import '../styles/global.css';
import { newQuestions } from '../lib/newQuestions';
import { publicationFor } from '../lib/publication';
const questionCount=1+newQuestions.length;
const reportCount=Object.keys(import.meta.glob('../content/reports/*.md')).length;
const privatePreview=newQuestions.some(q=>!publicationFor(q.id));
const { title, description = 'An evidence-linked, reproducible research pilot.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Open Questions Observatory</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar"><a class="brand" href="/"><span class="mark" aria-hidden="true">◌</span> Open Questions<br /><small>OBSERVATORY</small></a><nav aria-label="Main navigation"><a href="/questions/">Questions</a><a href="/methodology/">Methodology</a><a href="/about/">About this pilot</a></nav><span class="private">{privatePreview ? 'PRIVATE REVIEW PREVIEW' : 'PUBLISHED RESEARCH PILOT'}</span></header>
    <main id="main"><slot /></main>
    <footer><p>Evidence before conclusions.</p><span>{questionCount} questions · {reportCount} research notes · No general scientific resolution claimed</span><a href="/data/v1/manifest.json">Original frozen data manifest ↗</a></footer>
  </body>
</html>
