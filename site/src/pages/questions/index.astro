---
import Base from '../../layouts/Base.astro';
import pilot from '../../content/pilot.json';
---
<Base title="Question catalog">
<section class="page-head"><p class="eyebrow">THE CATALOG / 1 QUESTION</p><h1>Start with a question.</h1><p class="lede">Search the pilot's evidence-linked records and research report.</p></section>
<div class="search-box"><label for="catalog-search">Search questions and reports</label><input id="catalog-search" type="search" placeholder="Try spring, Niño or uncertainty" /><label for="discipline">Discipline</label><select id="discipline"><option value="">All disciplines</option><option value="climate-science">Climate science</option><option value="statistics">Statistics</option></select><p id="search-status" role="status" aria-live="polite">The complete pilot record is shown below.</p><div id="search-results"></div></div>
<article class="question-card" id="pilot-card"><p class="eyebrow">Q-ENSO-001 · CLIMATE SCIENCE / STATISTICS</p><h2><a href="/questions/Q-ENSO-001/">{pilot.question.title}</a></h2><p>Does adding calendar terms improve spring-initialized six-month forecast error over both simple baselines on the 2015–2026 record?</p><div class="badges"><span class="badge">No answer found in search</span><span class="badge">{pilot.question.statuses.research}</span><span class="badge">Computationally reproduced</span></div></article>
<script>
const input = document.querySelector<HTMLInputElement>('#catalog-search')!;
const select = document.querySelector<HTMLSelectElement>('#discipline')!;
const status = document.querySelector('#search-status')!;
const results = document.querySelector('#search-results')!;
let index: any;
const base = import.meta.env.BASE_URL;
let sequence = 0;
async function search() {
  const n = ++sequence;
  if (!input.value.trim()) { results.replaceChildren(); status.textContent = 'The complete pilot record is shown below.'; return; }
  try {
    index ??= await import(/* @vite-ignore */ `${base}pagefind/pagefind.js`);
    const response = await index.search(input.value, select.value ? { filters: { discipline: select.value } } : {});
    const data = await Promise.all(response.results.map((r: any) => r.data()));
    if (n !== sequence) return;
    results.replaceChildren();
    for (const hit of data) {
      const p = document.createElement('p'); const a = document.createElement('a');
      a.href = hit.url; a.textContent = hit.meta.title; p.append(a); results.append(p);
    }
    status.textContent = `${data.length} matching ${data.length === 1 ? 'page' : 'pages'}.`;
  } catch { status.textContent = 'Search is unavailable. The full pilot record remains linked below.'; }
}
input.addEventListener('input', search); select.addEventListener('change', search);
</script>
</Base>
