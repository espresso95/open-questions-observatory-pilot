---
import Base from '../../layouts/Base.astro';
import pilot from '../../content/pilot.json';
import { newQuestions } from '../../lib/newQuestions';
const questions = [pilot.question, ...newQuestions];
const disciplines = [...new Set(questions.flatMap(q => q.disciplines))].sort();
---
<Base title="Question catalog">
<section class="page-head"><p class="eyebrow">THE CATALOG / {questions.length} {questions.length===1?'QUESTION':'QUESTIONS'}</p><h1>Start with a question.</h1><p class="lede">Inspect the source evidence, documented search coverage, practical blockers and bounded investigations.</p></section>
<div class="search-box"><label for="catalog-search">Search questions and reports</label><input id="catalog-search" type="search" placeholder="Try spring, river flow or reversals" /><label for="discipline">Discipline</label><select id="discipline"><option value="">All disciplines</option>{disciplines.map(d => <option value={d}>{d.replaceAll('-',' ')}</option>)}</select><p id="search-status" role="status" aria-live="polite">The complete catalog is shown below.</p><div id="search-results"></div></div>
{questions.map(q => <article class="question-card" data-disciplines={q.disciplines.join(' ')}><p class="eyebrow">{q.id} · {q.disciplines.join(' / ')}</p><h2><a href={'/questions/'+q.id+'/'}>{q.title}</a></h2><p>{typeof q.scope==='string'?q.scope:q.scope.claim}</p><div class="badges"><span class="badge">{q.statuses.literature.replaceAll('_',' ')}</span><span class="badge">{q.statuses.feasibility.replaceAll('_',' ')}</span><span class="badge">{q.statuses.research.replaceAll('_',' ')}</span></div></article>)}
<script>
const input = document.querySelector<HTMLInputElement>('#catalog-search')!;
const select = document.querySelector<HTMLSelectElement>('#discipline')!;
const status = document.querySelector('#search-status')!;
const results = document.querySelector('#search-results')!;
let index: any;
const base = import.meta.env.BASE_URL;
let sequence = 0;
async function search() {
  const n = ++sequence;
  const cards = [...document.querySelectorAll<HTMLElement>('.question-card')];
  for (const card of cards) card.hidden = !!select.value && !card.dataset.disciplines?.split(' ').includes(select.value);
  if (!input.value.trim()) { results.replaceChildren(); status.textContent = `${cards.filter(card=>!card.hidden).length} questions shown.`; return; }
  try {
    index ??= await import(/* @vite-ignore */ `${base}pagefind/pagefind.js`);
    const response = await index.search(input.value, select.value ? { filters: { discipline: select.value } } : {});
    const data = await Promise.all(response.results.map((r: any) => r.data()));
    if (n !== sequence) return;
    results.replaceChildren();
    for (const hit of data) {
      const p = document.createElement('p'); const a = document.createElement('a');
      a.href = hit.url; a.textContent = hit.meta.title; p.append(a); results.append(p);
    }
    status.textContent = `${data.length} matching ${data.length === 1 ? 'page' : 'pages'}.`;
  } catch { status.textContent = 'Search is unavailable. The full pilot record remains linked below.'; }
}
input.addEventListener('input', search); select.addEventListener('change', search);
</script>
</Base>
